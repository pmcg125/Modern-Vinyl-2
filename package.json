{
  "name": "modernvinyl2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "ModernVinyl2 — local vinyl library web player, streetwear x terminal",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && vite preview",
    "serve": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,json,css,html,md}\"",
    "warm": "tsx --tsconfig tsconfig.server.json scripts/warm-cache.ts"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "express": "^5.2.1",
    "music-metadata": "^11.16.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
